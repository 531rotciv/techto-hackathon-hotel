def generate_summary_email(winning_hotel_dict, confirmation_number, audio_url, candidates_list):
    # winning_hotel_dict matches the dictionary structure from search_hotel.py's 'found' list
    
    reviewed_list_html = ""
    # We iterate through the 'candidates' list from your search_hotel.py
    for place in candidates_list:
        # We skip the winner so it doesn't show in the "skipped" list
        if place['name'] == winning_hotel_dict['name']:
            continue
            
        name = place.get('name', 'Unknown Hotel')
        price = place.get('total_price', 'N/A')
        # reason_skipped is flagged as missing below, using a placeholder for now
        reason_skipped = place.get('reason_skipped', 'Not selected by AI') 
        
        reviewed_list_html += f"<li><strong>{name}</strong> - ${price} <em>({reason_skipped})</em></li>"

    html_content = f"""
    <!DOCTYPE html>
    <html>
    <head>
        <style>
            body {{ font-family: Arial, sans-serif; color: #333; line-height: 1.6; }}
            .container {{ max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px; }}
            .header {{ background-color: #28a745; color: white; padding: 15px; text-align: center; border-radius: 8px 8px 0 0; }}
            .details {{ background-color: #f8f9fa; padding: 15px; border-left: 4px solid #28a745; margin: 20px 0; }}
            .audio-link {{ display: inline-block; padding: 10px 15px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px; }}
            .footer {{ font-size: 12px; color: #777; margin-top: 30px; border-top: 1px solid #ddd; padding-top: 10px; }}
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">
                <h2>✅ AI Booking Confirmed</h2>
            </div>
            
            <p>Your AI Agent has successfully negotiated and secured the lowest available hotel rate.</p>
            
            <div class="details">
                <!-- Using variables mapped from search_hotel.py -->
                <h3>Winning Reservation: {winning_hotel_dict.get('name')}</h3>
                <p><strong>Address:</strong> {winning_hotel_dict.get('address')}</p>
                <p><strong>Confirmed Price:</strong> ${winning_hotel_dict.get('total_price')}</p>
                <p><strong>Confirmation Number:</strong> <span style="font-size: 18px; color: #d9534f;">{confirmation_number}</span></p>
            </div>

            <h3>Audio Proof of Negotiation</h3>
            <p>Listen to the AI interacting with the hotel front desk:</p>
            <a href="{audio_url}" class="audio-link">🎧 Play Call Recording</a>

            <hr style="border: 0; border-top: 1px solid #eee; margin: 30px 0;">

            <h3>Audit Trail: Other Hotels Reviewed</h3>
            <ul>
                {reviewed_list_html}
            </ul>

            <div class="footer">
                <p>Generated by AutoBooker AI Engine</p>
            </div>
        </div>
    </body>
    </html>
    """
    
    return html_content
